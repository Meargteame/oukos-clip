# Copy this file to ".env" and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional settings (defaults shown)
# GEMINI_MODEL=gemini-flash-latest
# Your model's prices in USD per million tokens (for the spend counter). Check https://ai.google.dev/pricing
# GEMINI_INPUT_PRICE_PER_M=0.30
# GEMINI_OUTPUT_PRICE_PER_M=2.50
# CLIPS_PER_VIDEO=5
# MIN_CLIP_SECONDS=20
# MAX_CLIP_SECONDS=75
# OUTPUT_HEIGHT=1280          # 1280 = 720x1280 (fast). 1920 = 1080x1920 (slower to render).
# MAX_SOURCE_HEIGHT=1080      # quality of the YouTube video stream that gets cut
# CAPTION_LANGUAGE=           # e.g. "en". Empty = the video's own language.
# BURN_CAPTIONS=true
# REFRAME=auto                # auto = follow faces/speaker; center; fit (whole frame on blurred background)
# PYTHON_PATH=python          # needs: python -m pip install opencv-python-headless
# PORT=4321
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# ENCODER=auto              # auto = NVIDIA NVENC if it works, else CPU (x264). Force with: x264, nvenc, qsv, amf
