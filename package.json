{
  "name": "oukos-clip",
  "version": "0.1.0",
  "private": true,
  "description": "Local batch clipper: YouTube links in, vertical short clips out.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\""
  }
}
